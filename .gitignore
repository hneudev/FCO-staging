# ignore WordPress core files and directories
/[a-z]*.php
/wp-admin/
/wp-includes/
/readme.html
/license.txt
/xmlrpc.php

# Ignore configuration files and IDE settings
.htaccess
wp-config.php
.vscode/

# Ignore WordPress content directories that are not needed for version control
/wp-content/uploads/
/wp-content/blogs.dir/
/wp-content/upgrade/
/wp-content/backup-db/

# Ignore default plugins and themes (optional, if you only want to track your own)
# /wp-content/plugins/
# /wp-content/themes/twentytwentyfour/

# Ignore compressed files (backups)
*.tar.gz
*.zip
*.tgz
*.sql
*.log

# Ignore specific backup folders for common plugins
/wp-content/updraft/
/wp-content/backups/
/wp-content/ai1wm-backups/
# Server-generated caches, drop-ins and security/backup data (synced from staging, not versioned)
/wp-content/cache/
/wp-content/breeze-config/
/wp-content/advanced-cache.php
/wp-content/object-cache.php
/wp-content/mc_data/
/wp-content/upgrade-temp-backup/
/wp-content/wpvivid_staging/
/wp-content/wpvividbackups/
/wp-content/wpvivid_uploads/

# Stray backup copies
*.bak

# Local-only AI assistant context (would be public in public_html/)
CLAUDE.md
.claude/
